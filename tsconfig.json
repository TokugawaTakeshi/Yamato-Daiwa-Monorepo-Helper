{

  "compilerOptions": {

    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "types": [ "node" ],
    "skipLibCheck": true,
    "removeComments": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,

    "rootDir": "Source",
    "outDir": "Distributable",

  },

  "include": [ "Source/**/*" ]

}
